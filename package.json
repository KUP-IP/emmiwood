{
  "name": "emmiwood",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev client/dist --persist-to .wrangler/state --port 8788",
    "dev:e2e": "npm run e2e:prepare && wrangler pages dev ./static --cwd .deploy/pages --persist-to state --port ${EMMIWOOD_E2E_PORT:-8788} --binding ENVIRONMENT=preview --binding EMMIWOOD_PUBLIC_ORIGIN=http://localhost:${EMMIWOOD_E2E_PORT:-8788} --binding EMMIWOOD_BOOKING_WRITES_ENABLED=true --binding EMMIWOOD_NOTIFICATIONS_ENABLED=false",
    "build": "npm --prefix client run build",
    "typecheck": "npm --prefix client run typecheck",
    "test:unit": "node --test functions/lib/emmiwood-booking.test.js functions/lib/emmiwood-notifications.test.js functions/lib/emmiwood-admin.test.js functions/lib/emmiwood-launch.test.js",
    "test:release": "node --test scripts/release-preflight.test.mjs scripts/production-admin-seed.test.mjs",
    "e2e:prepare": "node scripts/prepare-e2e-artifact.mjs",
    "test:e2e": "npm run test:e2e:isolated",
    "test:e2e:isolated": "playwright test --config playwright.config.ts",
    "test:e2e:cross-browser": "playwright test --config playwright.cross-browser.config.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:live:contract": "node --test scripts/safe-live-request-guard.test.mjs",
    "test:brand": "node --test scripts/brand-assets-check.test.mjs && node scripts/brand-assets-check.mjs",
    "test": "npm run test:unit && npm run test:release && npm run typecheck && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply emmiwood-db --local",
    "release:preflight": "node scripts/release-preflight.mjs",
    "sms:self-verify-suite": "node scripts/sms-self-verify-suite.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "typescript": "5.9.3",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
